{
  "permissions": {
    "allow": [
      "Bash(brew:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(chmod:*)",
      "Bash(composer:*)",
      "Bash(cp:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(docker-compose:*)",
      "Bash(docker:*)",
      "Bash(echo:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(npm:*)",
      "Bash(open:*)",
      "Bash(php artisan:*)",
      "Bash(pnpm:*)",
      "Bash(pwd:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(uniq:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "Bash(yarn:*)",
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebSearch",
      "mcp__yerd__*",
      "mcp__laravel-boost__*",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_playwright_playwright__*"
    ],
    "defaultMode": "default"
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "laravel-simplifier@laravel": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "caveman@caveman": true,
    "claude-seo@agricidaniel-claude-seo": true
  },
  "extraKnownMarketplaces": {
    "laravel": {
      "source": {
        "source": "github",
        "repo": "laravel/claude-code"
      },
      "autoUpdate": true
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      },
      "autoUpdate": true
    },
    "agricidaniel-claude-seo": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-seo"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
